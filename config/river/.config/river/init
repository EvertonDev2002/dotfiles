#!/bin/sh
# 
#  RIVER COMPOSITOR CONFIGURATION
#  Sistema: Artix Linux (Runit)
#

# --- Carregar Configurações Centralizadas
# shellcheck disable=SC1091
. "${XDG_CONFIG_HOME:-$HOME/.config}/river/config.sh"

# --- Setup de Logs
mkdir -p "$DIR_LOG"
rm -f "$DIR_LOG/river.log"
exec >> "$DIR_LOG/river.log" 2>&1

echo ""
echo "════════════════════════════════════════════"
echo "  RIVER COMPOSITOR - $(date '+%d/%m/%Y %H:%M:%S')"
echo "════════════════════════════════════════════"
echo ""

# --- Iniciar serviços (em background para não redirecionar logs)
"$SCRIPT_SERVICES" &

# ---  FUNÇÕES HELPER (DRY)

map() { riverctl map normal "$@"; }
map_pointer() { riverctl map-pointer normal "$@"; }
spawn() { riverctl spawn "$@"; }

# --- CONFIGURAÇÃO DE INPUT E HARDWARE

# Teclado (PT-BR ABNT2)
riverctl keyboard-layout -model abnt2 br
riverctl set-repeat 50 300

# Touchpad
riverctl input "$TOUCHPAD_ID" tap enabled
riverctl input "$TOUCHPAD_ID" natural-scroll disabled
riverctl input "$TOUCHPAD_ID" tap-button-map left-right-middle
riverctl input "$TOUCHPAD_ID" disable-while-typing enabled
riverctl input "$TOUCHPAD_ID" accel-profile adaptive
riverctl input "$TOUCHPAD_ID" pointer-accel 0.0

# Cursor
riverctl focus-follows-cursor normal
riverctl set-cursor-warp on-focus-change
riverctl xcursor-theme "$CURSOR_THEME" "$CURSOR_SIZE"

# --- APARÊNCIA E LAYOUT

# Cores das Bordas
riverctl border-width "$BORDER_WIDTH"
riverctl border-color-focused "$BORDER_FOCUSED"
riverctl border-color-unfocused "$BORDER_UNFOCUSED"
riverctl border-color-urgent "$BORDER_URGENT"

# Rivertile
pkill -x rivertile
riverctl default-layout rivertile
rivertile -view-padding "$LAYOUT_PADDING_VIEW" -outer-padding "$LAYOUT_PADDING_OUTER" -main-ratio "$LAYOUT_MAIN_RATIO" &
riverctl default-attach-mode bottom

# --- MAPEAMENTOS: SISTEMA E APPS

# Apps
map "$MOD_KEY" T spawn "$TERMINAL"
map "$MOD_KEY" N spawn "$BROWSER"
map "$MOD_KEY" E spawn "$FILE_MANAGER"
map "$MOD_KEY" M spawn "$LAUNCHER"
map "$MOD_KEY" D spawn "$EDITOR_GUI"
map "$MOD_KEY" P spawn "$SCRIPT_MIRROR"

# Sistema
map "$MOD_KEY" Q close
map "$MOD_KEY"+Shift C spawn "$RIVER_CONFIG_DIR/init"
map "$MOD_KEY" Escape spawn "pkill waybar || waybar"
map None Print spawn "$SCRIPT_SCREENSHOT"

# --- MAPEAMENTOS: GERENCIAMENTO DE JANELAS

# Foco (Direcional HJKL + Setas)
map "$MOD_KEY" H focus-view left
map "$MOD_KEY" J focus-view down
map "$MOD_KEY" K focus-view up
map "$MOD_KEY" L focus-view right
map "$MOD_KEY" Left focus-view left
map "$MOD_KEY" Down focus-view down
map "$MOD_KEY" Up focus-view up
map "$MOD_KEY" Right focus-view right

# Mover Janela / Swap (Direcional HJKL + Setas)
map "$MOD_KEY"+Shift H swap left
map "$MOD_KEY"+Shift J swap down
map "$MOD_KEY"+Shift K swap up
map "$MOD_KEY"+Shift L swap right
map "$MOD_KEY"+Shift Down swap down
map "$MOD_KEY"+Shift Up swap up

# Zoom (Mestre)
map "$MOD_KEY" Return zoom

# Estados da Janela
map "$MOD_KEY" F toggle-float
map "$MOD_KEY"+Shift F toggle-fullscreen

# Rivertile tuning
map "$MOD_KEY" Space send-layout-cmd rivertile "main-ratio -0.05"
map "$MOD_KEY"+Shift Space send-layout-cmd rivertile "main-ratio +0.05"
map "$MOD_KEY"+Control H send-layout-cmd rivertile "main-count +1"
map "$MOD_KEY"+Control L send-layout-cmd rivertile "main-count -1"

# Monitores (Foco e Movimentação Espacial)
map "$MOD_KEY" bracketleft focus-output left
map "$MOD_KEY" bracketright focus-output right
map "$MOD_KEY"+Shift bracketleft send-to-output left
map "$MOD_KEY"+Shift bracketright send-to-output right

# --- MAPEAMENTOS: TAGS (WORKSPACES)

# Gera mapeamentos para tags 1 a 9
for i in $(seq 1 9); do
    tags=$((1 << ($i - 1)))
    map "$MOD_KEY" "$i" set-focused-tags $tags             # Focar Tag
    map "$MOD_KEY"+Shift "$i" set-view-tags $tags          # Mover para Tag
    map "$MOD_KEY"+Control "$i" toggle-focused-tags $tags  # Ver Tag junto com atual
    map "$MOD_KEY"+Shift+Control "$i" toggle-view-tags $tags # Fixar janela em +1 Tag
done

all_tags=$(((1 << 32) - 1))
map "$MOD_KEY" 0 set-focused-tags $all_tags

# Mouse (Super + Clique)
map_pointer "$MOD_KEY" BTN_LEFT move-view
map_pointer "$MOD_KEY" BTN_RIGHT resize-view
map_pointer "$MOD_KEY" BTN_MIDDLE toggle-float

# --- MODOS E TECLAS ESPECIAIS

# Modo Passthrough (Para VMs e Jogos) - Super+F11 ativa/desativa
riverctl declare-mode passthrough
map "$MOD_KEY" F11 enter-mode passthrough
riverctl map passthrough "$MOD_KEY" F11 enter-mode normal

# Teclas de Mídia (Volume/Brilho) - Funcionam mesmo com tela bloqueada
riverctl map normal None XF86AudioRaiseVolume spawn 'pactl set-sink-volume @DEFAULT_SINK@ +5%'
riverctl map normal None XF86AudioLowerVolume spawn 'pactl set-sink-volume @DEFAULT_SINK@ -5%'
riverctl map normal None XF86AudioMute spawn 'pactl set-sink-mute @DEFAULT_SINK@ toggle'
riverctl map normal None XF86AudioMicMute spawn 'pactl set-source-mute @DEFAULT_SOURCE@ toggle'
riverctl map normal None XF86MonBrightnessUp spawn 'brightnessctl set 5%+'
riverctl map normal None XF86MonBrightnessDown spawn 'brightnessctl set 5%-'
riverctl map normal None XF86AudioPlay spawn 'playerctl play-pause'
riverctl map normal None XF86AudioNext spawn 'playerctl next'
riverctl map normal None XF86AudioPrev spawn 'playerctl previous'

riverctl map locked None XF86AudioRaiseVolume spawn 'pactl set-sink-volume @DEFAULT_SINK@ +5%'
riverctl map locked None XF86AudioLowerVolume spawn 'pactl set-sink-volume @DEFAULT_SINK@ -5%'
riverctl map locked None XF86AudioMute spawn 'pactl set-sink-mute @DEFAULT_SINK@ toggle'
riverctl map locked None XF86MonBrightnessUp spawn 'brightnessctl set 5%+'
riverctl map locked None XF86MonBrightnessDown spawn 'brightnessctl set 5%-'
riverctl map locked None XF86AudioPlay spawn 'playerctl play-pause'
riverctl map locked None XF86AudioNext spawn 'playerctl next'
riverctl map locked None XF86AudioPrev spawn 'playerctl previous'

# --- REGRAS DE JANELA

# Remove barras de título
riverctl rule-add ssd

# Janelas Flutuantes (Função float_app)
riverctl rule-add -app-id 'org.gnome.Calculator' float
riverctl rule-add -title 'Authentication Required' float
riverctl rule-add -app-id 'firefox' -title 'Picture-in-Picture' float

# --- AUTOSTART (em background para não redirecionar logs)

"$SCRIPT_AUTOSTART" &

# Aguardar serviços essenciais antes de finalizar
sleep 0.5

echo "River iniciado com sucesso."