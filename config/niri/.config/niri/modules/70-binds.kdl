// Esta seção define atalhos de teclado.
// Mod refere-se à tecla Super (ou Logo, ou Windows).
// Você pode definir modificadores custom separadamente
// para cada tecla usando a sintaxe "Mod+Ctrl+..." ou "Super+Alt+...".
// Mantenha binds redundantes ao executar niri como sessão porque algumas vinculações vêm do portal xdg-desktop:
// - screenshot → abrir diálogo de screenshot
// - screencopy → abrir diálogo de captura de tela
// Se você não executar niri em modo sessão xdg-desktop-portal, sinta-se livre
// para removê-los ou alterá-los para fazer a captura/screenshot diretamente.
binds {
    // Aplicativos
    Mod+T     { spawn "kitty"; }
    Mod+N     { spawn "firefox"; }
    Mod+E     { spawn "nautilus"; }
    Mod+M     { spawn "fuzzel"; }
    Mod+D     { spawn "code"; }

    // Toggle espelhamento de tela (apresentações)
    Mod+P     { spawn-sh "~/.local/bin/utils/mirror-toggle.sh"; }

    // Controle do sistema
    Mod+Shift+C repeat=false { spawn-sh "niri msg action load-config-file"; }
    Mod+Escape repeat=false { spawn-sh "killall waybar || ~/.local/bin/init/autostart.sh"; }

    // Comandos exemplo de spawn.
    // Mod+T { spawn "alacritty"; }
    // Mod+T { spawn "alacritty" "msg" "create-window"; }
    // Mod+Return { spawn "alacritty" "--class" "alacritty-floating"; }

    // Exemplo de mapeamento de screenshot padrão, baseado em flameshot.
    // Você pode também usar spawn ou spawn-sh se quiser executar um comando.
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Screencopy (captura de vídeo) não disponível como ação direta
    // Use spawn para executar ferramenta externa como wf-recorder ou kooha
    // Mod+Print { spawn "kooha"; }
    // Mod+Ctrl+Print { spawn-sh "wf-recorder -g \"$(slurp)\" -f ~/Videos/$(date +%Y%m%d_%H%M%S).mp4"; }
    // Mod+Alt+Print { spawn-sh "wf-recorder -f ~/Videos/$(date +%Y%m%d_%H%M%S).mp4"; }

    // Exemplo de mapeamento de teclas de áudio usando wpctl.
    // "-l 1.0" limita o volume a 100%.
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // Exemplo de mapeamento de teclas de mídia usando playerctl.
    // Isso funcionará com qualquer reprodutor de mídia habilitado para MPRIS.
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    // Exemplo de mapeamento de teclas de brilho para brightnessctl.
    // Você pode usar spawn regular com múltiplos argumentos também (para evitar passar por "sh"),
    // mas precisa colocar manualmente cada argumento em aspas "" separadas.
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // Abrir/fechar a Visão Geral: uma visão ampliada de workspaces e janelas.
    // Você também pode mover o mouse para o canto superior esquerdo,
    // ou fazer um deslize de quatro dedos para cima no touchpad.
    Mod+O repeat=false { toggle-overview; }

    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    // Comandos alternativos que movem entre workspaces ao alcançar
    // a primeira ou última janela em uma coluna.
    // Mod+J     { focus-window-or-workspace-down; }
    // Mod+K     { focus-window-or-workspace-up; }
    // Mod+Ctrl+J     { move-window-down-or-to-workspace-down; }
    // Mod+Ctrl+K     { move-window-up-or-to-workspace-up; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // Alternativamente, existem comandos para mover apenas uma única janela:
    // Mod+Shift+Ctrl+Left  { move-window-to-monitor-left; }
    // ...

    // E você também pode mover um workspace inteiro para outro monitor:
    // Mod+Shift+Ctrl+Left  { move-workspace-to-monitor-left; }
    // ...

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    // Alternativamente, existem comandos para mover apenas uma única janela:
    // Mod+Ctrl+Page_Down { move-window-to-workspace-down; }
    // ...

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // Você pode vincular tiques de rolagem do scroll do mouse usando a seguinte sintaxe.
    // Essas vinculações mudarão de direção baseadas na configuração natural-scroll.
    //
    // Para evitar rolar por workspaces muito rápido, você pode usar
    // a propriedade cooldown-ms. A vinculação terá limite de taxa para este valor.
    // Você pode definir um cooldown em qualquer vinculação, mas é mais útil para a roda do mouse.
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // Geralmente rolar para cima e para baixo com Shift em aplicações resulta em
    // rolagem horizontal; essas vinculações replicam isso.
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Similarmente, você pode vincular "tiques" de rolagem do touchpad.
    // Rolagem do touchpad é contínua, então para essas vinculações é dividida em
    // intervalos discretos.
    // Essas vinculações também são afetadas pelo natural-scroll do touchpad, então essas
    // vinculações de exemplo estão "invertidas", já que temos natural-scroll habilitado para
    // touchpads por padrão.
    // Mod+TouchpadScrollDown { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02+"; }
    // Mod+TouchpadScrollUp   { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02-"; }

    // Você pode referir-se a workspaces por índice. Porém, tenha em mente que
    // niri é um sistema de workspace dinâmico, então esses comandos são meio
    // "melhor esforço". Tentar referir-se a um índice de workspace maior que
    // a contagem atual de workspaces irá em vez disso referir-se ao workspace mais abaixo
    // (vazio).
    //
    // Por exemplo, com 2 workspaces + 1 vazio, índices 3, 4, 5 e assim por diante
    // todos se referirão ao 3º workspace.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Alternativamente, existem comandos para mover apenas uma única janela:
    // Mod+Ctrl+1 { move-window-to-workspace 1; }

    // Alterna foco entre o workspace atual e o anterior.
    // Mod+Tab { focus-workspace-previous; }

    // As seguintes vinculações movem a janela focada para dentro e para fora de uma coluna.
    // Se a janela está sozinha, elas a consumirão para a coluna próxima ao lado.
    // Se a janela já está em uma coluna, elas a expelirão para fora.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Consome uma janela da direita para o fundo da coluna focada.
    Mod+Comma  { consume-window-into-column; }
    // Expele a janela inferior da coluna focada para a direita.
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    // Ciclar pelos presets em ordem reversa também é possível.
    // Mod+R { switch-preset-column-width-back; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // Expande a coluna focada para espaço não ocupado por outras colunas totalmente visíveis.
    // Faz a coluna "preencher o resto do espaço".
    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }

    // Centraliza todas as colunas totalmente visíveis na tela.
    Mod+Ctrl+C { center-visible-columns; }

    // Ajustes mais finos de largura.
    // Este comando também pode:
    // * definir largura em pixels: "1000"
    // * ajustar largura em pixels: "-5" ou "+5"
    // * definir largura como porcentagem da largura da tela: "25%"
    // * ajustar largura como porcentagem da largura da tela: "-10%" ou "+10%"
    // Tamanhos em pixels usam pixels lógicos, ou escalados. Ou seja, em uma saída com escala 2.0,
    // set-column-width "100" fará a coluna ocupar 200 pixels físicos da tela.
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Ajustes mais finos de altura quando em coluna com outras janelas.
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Move a janela focada entre o layout flutuante e o tiling.
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Alterna modo de exibição de coluna com abas.
    // Janelas nesta coluna aparecerão como abas verticais,
    // em vez de empilhadas uma sobre a outra.
    Mod+W { toggle-column-tabbed-display; }

    // Ações para alternar layouts.
    // Nota: se você descomentar estas, certifique-se de NÃO ter
    // um atalho de alternação de layout correspondente configurado nas opções xkb acima.
    // Ter ambos ao mesmo tempo no mesmo atalho quebrará a alternação,
    // já que alternará duas vezes ao pressionar o atalho (uma vez por xkb, uma vez por niri).
    // Mod+Space       { switch-layout "next"; }
    // Mod+Shift+Space { switch-layout "prev"; }
}
