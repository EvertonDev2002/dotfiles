# Configuração de fonte
font_family     FiraCodeNerdFont
font_size        20.0
line_height      1.0
letter_spacing    1.0

# Janela
background_opacity 0.9
initial_window_width  840
initial_window_height 400

# Configuração de cursor
cursor_shape     beam
cursor_blinking  never
cursor_shape_unfocused beam
