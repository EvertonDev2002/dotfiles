// Consulte  https://github.com/Alexays/Waybar/wiki/Configuration
{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "spacing": 4,
  "height": 24,
  "output": "eDP-1",
  "margin-bottom": 0,
  "margin-top": 0,
  "modules-left": ["river/tags"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "custom/clipboard",
    "backlight",
    "pulseaudio",
    "battery",
    "custom/power"
  ],
  "include": ["~/.config/waybar/modules.jsonc"]
}
