{
  // EDITOR - Configurações Gerais
  "editor.wordWrap": "on",
  "editor.fontSize": 16,
  "editor.lineHeight": 2.1,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.fontFamily": "FiraCode Nerd Font",
  "editor.fontLigatures": true,
  "editor.fontWeight": "normal",
  "editor.minimap.enabled": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.rulers": [79],
  "editor.largeFileOptimizations": true,
  "editor.smoothScrolling": false,
  "editor.renderWhitespace": "none",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.stickyScroll.enabled": false,
  "editor.hover.enabled": "on",
  "editor.inlayHints.enabled": "off",
  "editor.parameterHints.enabled": false,
  "editor.inlineSuggest.enabled": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  // Sugestões e Seleção
  "editor.semanticHighlighting.enabled": false,
  "editor.suggestSelection": "first",
  // Barras de Rolagem e Régua
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  // Colorização e Brackets
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.bracketPairsHorizontal": "active",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment",
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  // WORKBENCH - Interface e Aparência
  "workbench.startupEditor": "newUntitledFile",
  "workbench.colorTheme": "Min Dark",
  "workbench.iconTheme": "symbols",
  "workbench.productIconTheme": "fluent-icons",
  "workbench.preferredLightColorTheme": "Default Dark Modern",
  "workbench.colorCustomizations": {},
  "workbench.sideBar.location": "right",
  "workbench.activityBar.location": "bottom",
  "workbench.layoutControl.enabled": false,
  "workbench.enableExperiments": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  // Editor e Tabs
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.limit.value": 10,
  "workbench.editor.enablePreview": false,
  "workbench.editor.showTabs": "single",
  "workbench.editor.empty.hint": "hidden",
  // Árvore de Arquivos
  "workbench.tree.indent": 10,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.enableStickyScroll": false,
  // Outros
  "workbench.settings.applyToAllProfiles": ["editor.cursorBlinking"],
  "symbols.hidesExplorerArrows": true,
  "breadcrumbs.enabled": false,
  // JANELA - Window Settings
  "window.menuBarVisibility": "toggle",
  "window.commandCenter": false,
  "window.titleBarStyle": "native",
  "window.zoomLevel": 1,
  "window.customTitleBarVisibility": "never",
  // TERMINAL
  "terminal.integrated.fontSize": 15,
  "terminal.integrated.fontFamily": "FiraCode Nerd Font",
  "terminal.integrated.fontWeight": "normal",
  // EXPLORER - Navegação e File Nesting
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.openEditors.sortOrder": "alphabetical",
  "explorer.sortOrder": "foldersNestsFiles",
  // File Nesting
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": ".eslint*, prettier*, tsconfig*, vite*, pnpm-lock*, bun.lockb, nest*, pnpm-workspace*, .npmrc,",
    "tailwind.config.js": "tailwind.config*, postcss.config*",
    ".env.local": ".env*",
    ".env": ".env*",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  // FILES - Arquivos e Auto Save
  "files.autoSave": "afterDelay",
  "files.simpleDialog.enable": true,
  // Exclusões de Arquivos
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/__pycache__": true,
    "**/.venv": true,
    "**/vendor": true
  },
  // Watcher Exclusões
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/out/**": true,
    "**/.git/**": true,
    "**/.next/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.gradle/**": true,
    "**/.idea/**": true,
    "**/target/**": true,
    "**/vendor/**": true
  },
  // SEARCH - Busca
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/out": true,
    "**/.next": true,
    "**/__pycache__": true,
    "**/.venv": true,
    "**/.gradle": true,
    "**/target": true,
    "**/vendor": true
  },
  "search.useIgnoreFiles": true,
  "search.followSymlinks": false,
  "search.useGlobalIgnoreFiles": true,
  "search.searchOnType": false,
  // GIT - Controle de Versão
  "git.enabled": true,
  "git.autorefresh": false,
  "git.autofetch": true,
  "git.decorations.enabled": false,
  "git.openRepositoryInParentFolders": "always",
  "gitlens.telemetry.enabled": false,
  // GITHUB COPILOT
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  // FORMATADORES POR LINGUAGEM
  // Python
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.fixAll.unusedImports": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  // JavaScript
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "prettier.semi": true,
    "prettier.singleQuote": true
  },
  // JavaScript React
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "prettier.semi": true,
    "prettier.singleQuote": true
  },
  // JSON
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  // JSON com Comentários
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  // CSS
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  // Java
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  // Shell Script
  "[shellscript]": {
    "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode"
  },
  // Docker Compose
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  // GitHub Actions
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  // PYTHON - Configurações Específicas
  // Linting
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": false,
  "python.linting.flake8Enabled": true,
  // Testing
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  // Analysis
  "python.analysis.autoImportCompletions": true,
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.indexing": false,
  "python.analysis.autoSearchPaths": false,
  "python.analysis.useLibraryCodeForTypes": false,
  "python.analysis.openFilesOnly": true,
  "python.analysis.diagnosticMode": "openFilesOnly",
  // RUFF - Python Linter
  "ruff.enable": true,
  "ruff.lineLength": 79,
  "ruff.lint.select": ["I", "F", "E", "W", "PL", "PT", "N", "C4", "ICN"],
  // JAVASCRIPT / TYPESCRIPT
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.suggest.completeFunctionCalls": false,
  // TypeScript Server
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  "typescript.tsserver.maxTsServerMemory": 2048,
  "typescript.tsserver.log": "off",
  // PRETTIER - Formatador
  "prettier.enable": true,
  "prettier.singleQuote": false,
  "prettier.semi": false,
  // ESLINT
  "eslint.run": "onSave",
  // CODE RUNNER - Executor de Código
  "code-runner.runInTerminal": true,
  "code-runner.ignoreSelection": true,
  "code-runner.executorMap": {
    "javascript": "clear ; node",
    "python": "clear ; python -u",
    "typescript": "ts-node",
    "go": "go run",
    "php": "php",
    "java": "clear ; cd $dir && javac $fileName && java $fileNameWithoutExt",
    "rust": "cd $dir && rustc $fileName && $dir$fileNameWithoutExt",
    "zig": "zig run"
  },
  // SPELL CHECKER - Ortografia
  "cSpell.language": "en,pt-BR",
  "cSpell.suggestionMenuType": "quickFix",
  "cSpell.showAutocompleteDirectiveSuggestions": true,
  "cSpell.userWords": [
    "albumcover",
    "dublefy",
    "Dublue",
    "Dubluefy",
    "fastapi",
    "gestlab",
    "httpx",
    "imes",
    "learninglab",
    "ober",
    "onupdate",
    "poolclass",
    "pydantic",
    "senhateste",
    "spotify",
    "sqlalchemy",
    "sqlite",
    "tailwindcss",
    "ufat"
  ],
  // CHAT E ASSISTENTES
  "chat.commandCenter.enabled": false,
  "chat.extensionUnification.enabled": true,
  // TELEMETRIA - Privacidade
  "telemetry.telemetryLevel": "off",
  "telemetry.feedback.enabled": false,
  "update.showReleaseNotes": false,
  "workbench.statusBar.visible": false
}
