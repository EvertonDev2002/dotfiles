# Static information about the filesystems.
# See fstab(5) for details.

# <file system> <dir> <type> <options> <dump> <pass>
# /dev/nvme0n1p2 LABEL=ROOT
UUID=(...)	/         	btrfs     	rw,ssd,noatime,space_cache=v2,compress=zstd:1,commit=120,subvol=/	0 1

# /dev/... LABEL=BOOT
UUID=(...)					/boot/efi 	vfat     	defaults,nodev,nosuid,noexec,fmask=0177,dmask=0077				0 2

# /dev/(...)
UUID=	/home		btrfs		rw,noatime,compress=zstd:1,space_cache=v2,commit=120,subvol=@home	        0 2

