// Consulte  https://github.com/Alexays/Waybar/wiki/Configuration
{
  "layer": "top", // Waybar at top layer
  "position": "top", // Waybar position (top|bottom|left|right)
  "reload_style_on_change": true,
  "spacing": 0,
  "height": 20,
  "output": "eDP-1", // Especifica em qual tela a barra será exibida.
  "margin-bottom": 0,
  "margin-top": 0,
  "modules-left": ["sway/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "bluetooth",
    "backlight",
    "pulseaudio",
    "battery",
    "custom/power"
  ],
  "include": ["~/.config/waybar/modules.jsonc"]
}
