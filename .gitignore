# VisualStudioCode
.vscode

# Logs e Temporários
*.log

# PipeWire
stream-properties

# CONFIG - Ignorar tudo EXCETO arquivos gerenciados pelo repositório
------------------------------------------------------------------------------
# Estratégia: Ignorar tudo em config/, depois não ignorar arquivo por arquivo

# Ignorar tudo por padrão
config/**/*

# Aceitar arquivo .stow-local-ignore
!config/.stow-local-ignore

# --- alacritty ---
!config/alacritty/
!config/alacritty/alacritty.toml

# --- Code ---
!config/code/.config/Code/
!config/code/.config/Code/User/settings.json
!config/code/.config/Code/User/profiles/*

# --- fish ---
!config/fish/
!config/fish/.config/
!config/fish/.config/fish/
!config/fish/.config/fish/config.fish
!config/fish/.config/fish/aliases.fish
!config/fish/.config/fish/functions/
!config/fish/.config/fish/functions/ls-service-running.fish

# --- fastfetch ---
!config/fastfetch/
!config/fastfetch/.config/
!config/fastfetch/.config/fastfetch/
!config/fastfetch/.config/fastfetch/config.jsonc

